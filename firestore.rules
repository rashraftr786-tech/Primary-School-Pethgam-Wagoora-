rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth!=null;}
    function isBootstrapAdmin(){return signedIn() && request.auth.token.email=="pspathgam@gmail.com";}
    function isSchoolAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ["admin","hoi"] && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active==true;}
    function account(){return get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data;}
    function linkedStudent(id){return signedIn() && exists(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)) && (account().studentRecordId==id || account().sourceAdmissionId==id);}
    function ownStaffDoc(){return signedIn() && resource.data.authUid==request.auth.uid;}
    function ownStaffWrite(){return signedIn() && request.resource.data.authUid==request.auth.uid;}
    match /admins/{id}{allow read:if signedIn()&&(id==request.auth.uid||isSchoolAdmin());allow create:if id==request.auth.uid&&isBootstrapAdmin()&&request.resource.data.role=="admin"&&request.resource.data.active==true&&request.resource.data.email==request.auth.token.email;allow update:if (isSchoolAdmin()||(id==request.auth.uid&&isBootstrapAdmin()))&&request.resource.data.role=="admin"&&request.resource.data.active==true&&request.resource.data.email==request.auth.token.email;allow delete:if isSchoolAdmin();}
    match /staffLoginIndex/{employeeId}{allow read:if true;allow write:if isSchoolAdmin();}
    match /staff/{id}{allow read:if isSchoolAdmin()||ownStaffDoc();allow create,update,delete:if isSchoolAdmin();}
    match /teachingAssignments/{id}{allow read:if signedIn();allow create,update,delete:if isSchoolAdmin();}
    match /staffAttendance/{id}{allow read:if isSchoolAdmin()||(signedIn()&&resource.data.staffAuthUid==request.auth.uid);allow create,update:if isSchoolAdmin()||ownStaffWrite();allow delete:if isSchoolAdmin();}
    match /staffLeaves/{id}{allow read:if isSchoolAdmin()||(signedIn()&&resource.data.staffAuthUid==request.auth.uid);allow create:if isSchoolAdmin()||ownStaffWrite();allow update:if isSchoolAdmin()||(signedIn()&&resource.data.staffAuthUid==request.auth.uid);allow delete:if isSchoolAdmin();}
    match /aayaDuties/{id}{allow read:if isSchoolAdmin()||(signedIn()&&resource.data.staffAuthUid==request.auth.uid);allow create,update:if isSchoolAdmin()||ownStaffWrite();allow delete:if isSchoolAdmin();}
    match /mdmDaily/{id}{allow read:if isSchoolAdmin()||(signedIn()&&resource.data.cookAuthUid==request.auth.uid);allow create,update:if isSchoolAdmin()||(signedIn()&&request.resource.data.cookAuthUid==request.auth.uid);allow delete:if isSchoolAdmin();}
    match /riceStock/{id}{allow read:if signedIn();allow create,update:if isSchoolAdmin();allow delete:if isSchoolAdmin();}
    match /institution/{docId}{allow read:if signedIn();allow write:if isSchoolAdmin();}
    match /studentAccounts/{id}{allow read:if isSchoolAdmin()||(signedIn()&&request.auth.uid==id);allow create,update,delete:if isSchoolAdmin();}
    match /studentLoginIndex/{admissionNo}{allow read:if true;allow write:if isSchoolAdmin();}
    match /students/{id}{allow read:if isSchoolAdmin()||linkedStudent(id)||signedIn();allow write:if isSchoolAdmin();}
    match /students/{id}/{sub=**}{allow read:if isSchoolAdmin()||linkedStudent(id)||signedIn();allow write:if isSchoolAdmin();}
    match /marksheets/{id}{allow read:if signedIn();allow write:if isSchoolAdmin();}
    match /results/{id}{allow read:if signedIn();allow write:if isSchoolAdmin();}
    match /notices/{id}{allow read:if signedIn();allow write:if isSchoolAdmin();}
    match /calendar/{id}{allow read:if signedIn();allow write:if isSchoolAdmin();}
    match /timetables/{id}{allow read:if signedIn();allow write:if isSchoolAdmin();}
    match /homework/{id}{allow read:if signedIn();allow create:if isSchoolAdmin()||(signedIn()&&request.resource.data.teacherAuthUid==request.auth.uid);allow update,delete:if isSchoolAdmin()||(signedIn()&&resource.data.teacherAuthUid==request.auth.uid);}
    match /assignments/{id}{allow read:if signedIn();allow write:if isSchoolAdmin()||signedIn();}
    match /teacherMessages/{id}{allow read:if signedIn();allow create:if isSchoolAdmin()||(signedIn()&&request.resource.data.teacherAuthUid==request.auth.uid);allow update,delete:if isSchoolAdmin()||(signedIn()&&resource.data.teacherAuthUid==request.auth.uid);}
    match /communications/{id}{allow read:if signedIn();allow write:if isSchoolAdmin()||signedIn();}
    match /attendance/{id}{allow read:if signedIn();allow write:if isSchoolAdmin()||signedIn();}
    match /libraryBooks/{id}{allow read:if signedIn();allow write:if isSchoolAdmin();}
    match /libraryTransactions/{id}{allow read:if signedIn();allow write:if isSchoolAdmin();}
    match /studentLeaves/{id}{allow read:if isSchoolAdmin()||(signedIn()&&resource.data.studentUid==request.auth.uid);allow create:if signedIn()&&request.resource.data.studentUid==request.auth.uid;allow update:if isSchoolAdmin()||(signedIn()&&resource.data.studentUid==request.auth.uid&&resource.data.status=="Modification Required");allow delete:if isSchoolAdmin();}
    match /officialApplications/{id}{allow read,create,update,delete:if isSchoolAdmin();}
    match /auditHistory/{id}{allow read,create:if isSchoolAdmin();allow update,delete:if false;}
    match /{document=**}{allow read,write:if false;}
  }
}
