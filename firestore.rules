rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function bootstrapAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == "pspathgam@gmail.com";
    }

    function adminDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSystemAdmin() {
      return bootstrapAdmin()
        || (
          adminDoc()
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin"
        );
    }

    function isHOI() {
      return bootstrapAdmin()
        || (
          adminDoc()
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "hoi"
        );
    }

    function isSchoolAdmin() {
      return isSystemAdmin() || isHOI();
    }

    function studentAccountExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/studentAccounts/$(request.auth.uid));
    }

    function studentAccount() {
      return get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid));
    }

    function linkedStudent(studentId) {
      return studentAccountExists()
        && (
          studentAccount().data.studentRecordId == studentId
          || studentAccount().data.sourceAdmissionId == studentId
        );
    }

    function linkedStudentByAdmission(admissionNo) {
      return studentAccountExists()
        && (
          studentAccount().data.admissionNo == admissionNo
          || studentAccount().data.loginId == admissionNo
        );
    }

    function linkedStaff(staffId) {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(staffId))
        && get(/databases/$(database)/documents/staff/$(staffId)).data.authUid == request.auth.uid
        && get(/databases/$(database)/documents/staff/$(staffId)).data.status != "Inactive";
    }

    function staffRole(staffId) {
      return get(/databases/$(database)/documents/staff/$(staffId)).data.accessRole;
    }

    function isStaffRole(staffId, roleCode) {
      return linkedStaff(staffId) && staffRole(staffId) == roleCode;
    }

    function assignedTeacher(studentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/students/$(studentId)).data.assignedTeacherUids != null
        && request.auth.uid in get(/databases/$(database)/documents/students/$(studentId)).data.assignedTeacherUids;
    }

    function teacherOwn(data) {
      return signedIn()
        && data.teacherAuthUid == request.auth.uid
        && data.teacherId != null
        && linkedStaff(data.teacherId);
    }

    function staffOwn(data) {
      return signedIn()
        && data.staffAuthUid == request.auth.uid
        && data.staffId != null
        && linkedStaff(data.staffId);
    }

    match /admins/{id} {
      allow read: if signedIn() && (request.auth.uid == id || isSchoolAdmin());
      allow create, update: if isSystemAdmin();
      allow delete: if isSystemAdmin();
    }

    match /staff/{staffId} {
      allow read: if isSchoolAdmin() || linkedStaff(staffId);
      allow create, update, delete: if isSystemAdmin();
    }

    match /staffLoginIndex/{employeeId} {
      allow read: if true;
      allow create, update, delete: if isSystemAdmin();
    }

    match /staffAuthIndex/{uid} {
      allow read: if isSystemAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isSystemAdmin();
    }

    match /teachingAssignments/{id} {
      allow read: if isSchoolAdmin()
        || (resource.data.staffId != null && linkedStaff(resource.data.staffId));
      allow create, update, delete: if isSystemAdmin();
    }

    match /staffAttendance/{id} {
      allow read: if isSchoolAdmin() || staffOwn(resource.data);
      allow create: if isSchoolAdmin() || staffOwn(request.resource.data);
      allow update: if isSchoolAdmin()
        || (
          staffOwn(resource.data)
          && request.resource.data.staffId == resource.data.staffId
          && request.resource.data.staffAuthUid == request.auth.uid
        );
      allow delete: if isSystemAdmin();
    }

    match /staffLeaves/{id} {
      allow read: if isHOI() || isSystemAdmin() || staffOwn(resource.data);
      allow create: if isHOI() || isSystemAdmin() || staffOwn(request.resource.data);
      allow update: if isHOI() || isSystemAdmin()
        || (
          staffOwn(resource.data)
          && resource.data.decision == "Modification Required"
          && request.resource.data.staffId == resource.data.staffId
          && request.resource.data.staffAuthUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["from","to","reason","updatedAt"])
        );
      allow delete: if isSystemAdmin();
    }

    match /aayaDuties/{id} {
      allow read: if isSchoolAdmin()
        || (resource.data.staffId != null && isStaffRole(resource.data.staffId, "AAYA"));
      allow create, update: if isSchoolAdmin()
        || (
          request.resource.data.staffId != null
          && isStaffRole(request.resource.data.staffId, "AAYA")
          && request.resource.data.staffAuthUid == request.auth.uid
        );
      allow delete: if isSystemAdmin();
    }

    match /mdmDaily/{id} {
      allow read: if isSchoolAdmin()
        || (resource.data.cookId != null && isStaffRole(resource.data.cookId, "COOK"));
      allow create, update: if isSchoolAdmin()
        || (
          request.resource.data.cookId != null
          && isStaffRole(request.resource.data.cookId, "COOK")
          && request.resource.data.cookAuthUid == request.auth.uid
        );
      allow delete: if isSystemAdmin();
    }

    match /riceStock/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isSystemAdmin();
    }

    match /institution/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isSystemAdmin();
    }

    match /studentAccounts/{id} {
      allow read: if isSystemAdmin() || isHOI() || (signedIn() && request.auth.uid == id);
      allow create, delete: if isSystemAdmin() || isHOI();
      allow update: if isSystemAdmin() || isHOI()
        || (
          signedIn()
          && request.auth.uid == id
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["mustChangePassword","passwordChangedAt"])
        );
    }

    match /studentLoginIndex/{admissionNo} {
      allow read: if true;
      allow create, update, delete: if isSystemAdmin() || isHOI();
    }

    match /students/{id} {
      allow read: if isSchoolAdmin() || linkedStudent(id) || assignedTeacher(id);
      allow create, update, delete: if isSystemAdmin() || isHOI();

      match /attendance/{subId} {
        allow read: if isSchoolAdmin() || linkedStudent(id) || assignedTeacher(id);
        allow create, update: if isSchoolAdmin() || assignedTeacher(id);
        allow delete: if isSystemAdmin() || isHOI();
      }

      match /results/{subId} {
        allow read: if isSchoolAdmin() || linkedStudent(id) || assignedTeacher(id);
        allow create, update, delete: if isSystemAdmin() || isHOI();
      }

      match /communications/{subId} {
        allow read: if isSchoolAdmin() || linkedStudent(id) || assignedTeacher(id);
        allow create: if isSchoolAdmin()
          || (
            assignedTeacher(id)
            && request.resource.data.teacherAuthUid == request.auth.uid
          );
        allow update: if isSchoolAdmin()
          || (
            assignedTeacher(id)
            && resource.data.teacherAuthUid == request.auth.uid
            && request.resource.data.teacherAuthUid == request.auth.uid
          );
        allow delete: if isSystemAdmin() || isHOI();
      }

      match /library/{subId} {
        allow read: if isSchoolAdmin() || linkedStudent(id);
        allow create, update, delete: if isSystemAdmin() || isHOI();
      }

      match /{subcollection}/{subId} {
        allow read: if isSchoolAdmin() || linkedStudent(id) || assignedTeacher(id);
        allow create, update, delete: if isSystemAdmin() || isHOI();
      }
    }

    match /marksheets/{admissionNo} {
      allow read: if isSchoolAdmin()
        || linkedStudentByAdmission(admissionNo)
        || (
          resource.data.studentRecordId != null
          && (linkedStudent(resource.data.studentRecordId) || assignedTeacher(resource.data.studentRecordId))
        );
      allow create, update, delete: if isSystemAdmin() || isHOI();
    }

    match /results/{id} {
      allow read: if isSchoolAdmin()
        || (
          resource.data.studentRecordId != null
          && (linkedStudent(resource.data.studentRecordId) || assignedTeacher(resource.data.studentRecordId))
        );
      allow create, update, delete: if isSystemAdmin() || isHOI();
    }

    match /notices/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isSchoolAdmin();
    }

    match /calendar/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isSchoolAdmin();
    }

    match /timetables/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isSchoolAdmin();
    }

    match /libraryBooks/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isSystemAdmin() || isHOI();
    }

    match /libraryTransactions/{id} {
      allow read, create, update, delete: if isSystemAdmin() || isHOI();
    }

    match /homework/{id} {
      allow read: if isSchoolAdmin() || teacherOwn(resource.data);
      allow create: if isSchoolAdmin() || teacherOwn(request.resource.data);
      allow update: if isSchoolAdmin()
        || (
          teacherOwn(resource.data)
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.teacherAuthUid == request.auth.uid
        );
      allow delete: if isSystemAdmin() || isHOI();
    }

    match /assignments/{id} {
      allow read: if isSchoolAdmin() || teacherOwn(resource.data);
      allow create: if isSchoolAdmin() || teacherOwn(request.resource.data);
      allow update: if isSchoolAdmin()
        || (
          teacherOwn(resource.data)
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.teacherAuthUid == request.auth.uid
        );
      allow delete: if isSystemAdmin() || isHOI();
    }

    match /teacherMessages/{id} {
      allow read: if isSchoolAdmin() || teacherOwn(resource.data);
      allow create: if isSchoolAdmin() || teacherOwn(request.resource.data);
      allow update: if isSchoolAdmin()
        || (
          teacherOwn(resource.data)
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.teacherAuthUid == request.auth.uid
        );
      allow delete: if isSystemAdmin() || isHOI();
    }

    match /studentLeaves/{id} {
      allow read: if isHOI()
        || isSystemAdmin()
        || (
          resource.data.assignedTeacherUids != null
          && request.auth.uid in resource.data.assignedTeacherUids
        )
        || (
          resource.data.studentRecordId != null
          && linkedStudent(resource.data.studentRecordId)
        );

      allow create: if isHOI()
        || isSystemAdmin()
        || (
          studentAccountExists()
          && request.resource.data.studentRecordId != null
          && linkedStudent(request.resource.data.studentRecordId)
          && request.resource.data.studentUid == request.auth.uid
          && request.resource.data.status == "Pending"
        );

      allow update: if isHOI() || isSystemAdmin()
        || (
          request.resource.data.assignedTeacherUids != null
          && request.auth.uid in request.resource.data.assignedTeacherUids
          && request.resource.data.studentRecordId == resource.data.studentRecordId
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["teacherStatus","teacherRemarks","teacherActedAt","updatedAt"])
        )
        || (
          linkedStudent(resource.data.studentRecordId)
          && resource.data.studentUid == request.auth.uid
          && request.resource.data.studentRecordId == resource.data.studentRecordId
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["from","to","reason","updatedAt"])
        );

      allow delete: if isSystemAdmin();
    }

    match /workBehaviourApplications/{id} {
      allow read: if isHOI() || isSystemAdmin() || teacherOwn(resource.data);
      allow create: if isHOI() || isSystemAdmin() || teacherOwn(request.resource.data);
      allow update: if isHOI() || isSystemAdmin()
        || (
          teacherOwn(resource.data)
          && request.resource.data.staffId == resource.data.staffId
          && request.resource.data.staffAuthUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["purpose","remarks","updatedAt"])
        );
      allow delete: if isSystemAdmin();
    }

    match /studentCertificateApplications/{id} {
      allow read: if isHOI()
        || isSystemAdmin()
        || (
          resource.data.assignedTeacherUids != null
          && request.auth.uid in resource.data.assignedTeacherUids
        )
        || (
          resource.data.studentUid == request.auth.uid
        );

      allow create: if isHOI()
        || isSystemAdmin()
        || (
          studentAccountExists()
          && request.resource.data.studentUid == request.auth.uid
          && request.resource.data.studentRecordId != null
          && linkedStudent(request.resource.data.studentRecordId)
          && request.resource.data.status == "Pending"
          && request.resource.data.hoiStatus == "Pending"
        );

      allow update: if isHOI() || isSystemAdmin()
        || (
          request.resource.data.assignedTeacherUids != null
          && request.auth.uid in request.resource.data.assignedTeacherUids
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.studentRecordId == resource.data.studentRecordId
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["teacherStatus","teacherRemarks","teacherActedAt","updatedAt"])
        )
        || (
          resource.data.studentUid == request.auth.uid
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.studentRecordId == resource.data.studentRecordId
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["purpose","remarks","updatedAt"])
        );

      allow delete: if isSystemAdmin();
    }

    match /notifications/{id} {
      allow read: if isSystemAdmin()
        || isHOI()
        || (signedIn() && resource.data.recipientUid == request.auth.uid);

      allow create: if isSystemAdmin() || isHOI()
        || (
          signedIn()
          && request.resource.data.recipientUid == request.auth.uid
          && request.resource.data.type in ["SELF"]
        );

      allow update: if isSystemAdmin() || isHOI()
        || (
          signedIn()
          && resource.data.recipientUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read","readAt"])
        );

      allow delete: if isSystemAdmin() || isHOI();
    }

    match /officialApplications/{id} {
      allow read, create, update, delete: if isHOI() || isSystemAdmin();
    }

    match /auditHistory/{id} {
      allow read: if isSystemAdmin() || isHOI();
      allow create: if isSystemAdmin() || isHOI()
        || (
          signedIn()
          && request.resource.data.actingUid == request.auth.uid
          && request.resource.data.module in ["studentLeaves","studentCertificateApplications","workBehaviourApplications","staffLeaves"]
        );
      allow update, delete: if false;
    }

    match /attendance/{id} {
      allow read, write: if isSystemAdmin() || isHOI();
    }

    match /communications/{id} {
      allow read, write: if isSystemAdmin() || isHOI();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
